(* Beginning of Notebook Content *)
Notebook[{
Cell["CHESS BHB family example", "Title",ExpressionUUID->"412e39b5-5c89-43e3-b0be-d105d661183e"],

Cell["\<\
This notebook demonstrates the complete BHB workflow in the release package: \
locate the release files, load CHESS, read the alphabet derivatives and \
Atilde matrix, convert legacy letter names to the unified logW form, prepare \
the cached matrix data, read the boundary values, run the \
left-endpoint-regularized spectral solve, and inspect the final integral \
values.\
\>", "Text",ExpressionUUID->"838adf1e-cb52-43a9-a154-4e196c2dab61"],

Cell["1. Session setup", "Section",ExpressionUUID->"36535cfe-1f06-4376-926a-b827c3c167bb"],

Cell["\<\
Start from a clean Global context.  The notebook is saved in the examples \
directory, so NotebookDirectory[] locates the release tree.\
\>", "Text",ExpressionUUID->"5c720889-684e-412a-80e9-7605be586d14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
  RowBox[{"$HistoryLength", "=", "0"}], ";"}]], "Input",ExpressionUUID->\
"806307fb-320d-4835-bdd2-df321747cf88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exampleDir", "=", 
   RowBox[{"NotebookDirectory", "[", "]"}]}], ";", 
  RowBox[{"releaseDir", "=", 
   RowBox[{"DirectoryName", "[", "exampleDir", "]"}]}], ";", 
  RowBox[{"dataDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"releaseDir", ",", "\"\<data\>\"", ",", "\"\<3L5P\>\"", ",", 
      "\"\<BHB\>\""}], "}"}], 
    "]"}]}], ";", 
  RowBox[{"packageFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"releaseDir", ",", "\"\<Chess.wl\>\""}], "}"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"da5b3a17-300c-4c0d-8650-ca14065ebed1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox[
    RowBox[{"requireFile", "::", "missing"}], "MessageName"], 
   "=", "\"\<Required file does not exist: `1`\>\""}], ";", 
  RowBox[{
   RowBox[{"requireFile", "[", "file_String", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "file", "]"}], ",", "file", ",", 
     RowBox[{
      RowBox[{"Message", "[", 
       RowBox[{
        StyleBox[
         RowBox[{"requireFile", "::", "missing"}], "MessageName"], ",", 
        "file"}], "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}]], "Input",ExpressionUUID\
->"e9f58082-8d6f-4ab7-8f51-1a254d1ba8c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"requiredFiles", "=", 
   RowBox[{"{", 
    RowBox[{"packageFile", ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "\"\<dLettersLine.wl\>\""}], "}"}], "]"}], ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "\"\<Atilde.m\>\""}], "}"}], "]"}], ",", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "\"\<BCnum.m\>\""}], "}"}], "]"}]}], 
    "}"}]}], ";", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#1", ",", 
           RowBox[{"FileExistsQ", "[", "#1", "]"}]}], "}"}], "&"}], ")"}], "/@",
        "requiredFiles"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<file\>\"", ",", "\"\<exists\>\""}], "}"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]], "Input",ExpressionUUID->\
"998964fa-e82b-461a-bdb1-87f9bebe23fc"],

Cell["2. Load CHESS", "Section",ExpressionUUID->"345bef0b-b1c8-45b5-9809-168a0cbf8e3e"],

Cell["\<\
Load the package file from the release root.  The package exposes \
SpectralPropagate, nAt, and lightweight result accessors such as \
CHESSFinalState.\
\>", "Text",ExpressionUUID->"f5a34278-c268-45bf-9ea5-e2317673f60a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"requireFile", "[", "packageFile", "]"}], "]"}], ";"}]], "Input",Ex\
pressionUUID->"4d36e23e-f813-4b49-82fc-2a145057a824"],

Cell[BoxData[
 RowBox[{"Options", "[", "SpectralPropagate", "]"}]], "Input",ExpressionUUID->"767b868d-2245-4879-86c2-8649d339814a"],

Cell["3. Read the BHB alphabet along the line", "Section",ExpressionUUID->"23f5b84a-3d29-4b99-a023-dd20c05e0487"],

Cell["\<\
dLettersLine stores the already-prepared d log W(t) values along the \
one-dimensional path.  This file is read once, then nAt evaluates the \
differential matrix by inserting these values into Atilde.\
\>", "Text",ExpressionUUID->"ce8b81c0-9849-45be-91db-04a01db07b94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dLettersLineFile", "=", 
   RowBox[{"requireFile", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dataDir", ",", "\"\<dLettersLine.wl\>\""}], "}"}], "]"}], 
    "]"}]}], ";", 
  RowBox[{"dLettersLine", "=", 
   RowBox[{"Get", "[", "dLettersLineFile", "]"}]}], ";"}]], "Input",Expression\
UUID->"75d19a72-b288-41f7-8d2c-6f0f228bacb8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "dLettersLine", "]"}], ",", 
   TagBox["dLettersLine",
    Short[#, 3]& ]}], "}"}]], "Input",ExpressionUUID->"ac0f66b8-03b7-4ab3-\
8483-48e0049338d0"],

Cell["4. Read and standardize Atilde", "Section",ExpressionUUID->"58d89b1f-58b7-44a6-aa23-1d8a4eedd1b1"],

Cell["\<\
The release package only uses the unified logW[i] letter interface.  The BHB \
input still contains the older Wtilde/What notation, so this notebook \
performs the conversion outside the package.\
\>", "Text",ExpressionUUID->"de309f53-5532-4c86-b7e8-9383a55da843"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atildeFile", "=", 
   RowBox[{"requireFile", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dataDir", ",", "\"\<Atilde.m\>\""}], "}"}], "]"}], "]"}]}], ";", 
  RowBox[{"rawAtilde", "=", 
   RowBox[{"Get", "[", "atildeFile", "]"}]}], ";"}]], "Input",ExpressionUUID->\
"7a059290-aa6b-4fa9-98a6-444d54b7d8cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "rawAtilde", "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"SparseArray", "[", "rawAtilde", "]"}], 
     "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}], "}"}]], "Input",ExpressionU\
UID->"9afd06d5-dc7e-4fa2-b8c2-f246546addfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "unifiedAtilde", "]"}], ";", 
  RowBox[{
   RowBox[{"unifiedAtilde", "[", "raw_", "]"}], ":=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"raw", "/.", "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"W", "[", "i_Integer", "]"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"logW", "[", "i", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"Wtilde", "[", "i_Integer", "]"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"logW", "[", 
         RowBox[{"100", "+", "i"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"What", "[", "i_Integer", "]"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"logW", "[", 
         RowBox[{"200", "+", "i"}], "]"}]}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"af614b17-9b5c-46e7-8b10-a3f99fa991dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CHESSClearCaches", "[", "]"}], ";", 
  RowBox[{"Atilde", "=", 
   RowBox[{"unifiedAtilde", "[", "rawAtilde", "]"}]}], ";"}]], "Input",Express\
ionUUID->"43aab191-efa1-48fc-961e-2ddac07247ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "Atilde", "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"Atilde", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{"Head", "/@", 
     RowBox[{"Cases", "[", 
      RowBox[{"Atilde", ",", "_logW", ",", "\[Infinity]"}], "]"}]}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"78810997-3b86-4949-b60a-3743b7978e51"],

Cell["5. Prepare fast Atilde data", "Section",ExpressionUUID->"a6a5cd5a-f617-444c-afc0-e9b382577ccc"],

Cell["\<\
CHESSAtildeLinearData converts the symbolic Atilde matrix into slot-indexed \
sparse matrix data.  After this step, nAt can form A(t) by a numeric linear \
combination of those sparse blocks.\
\>", "Text",ExpressionUUID->"2abe012d-407e-493c-838a-80d7a6266787"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atildeLinearData", "=", 
   RowBox[{"CHESSAtildeLinearData", "[", "]"}]}], ";"}]], "Input",ExpressionUU\
ID->"959af5d2-0182-4251-abfe-eb44aaaaca21"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", 
    RowBox[{
    "atildeLinearData", "\[LeftDoubleBracket]", "1", 
     "\[RightDoubleBracket]"}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{
    "atildeLinearData", "\[LeftDoubleBracket]", "2", 
     "\[RightDoubleBracket]"}], "]"}], ",", 
   RowBox[{"Dimensions", "[", 
    RowBox[{
    "atildeLinearData", "\[LeftDoubleBracket]", "3", 
     "\[RightDoubleBracket]"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"00bf27f4-88dd-4cb8-8464-f3f24df06c3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"midPointMatrix", "=", 
   RowBox[{"nAt", "[", 
    RowBox[{
     FractionBox["1", "2"], ",", "50"}], "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Head", "[", "midPointMatrix", "]"}], ",", 
    RowBox[{"Dimensions", "[", "midPointMatrix", "]"}], ",", 
    RowBox[{"Length", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", "midPointMatrix", "]"}], 
      "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}], "}"}]}]], "Input",Expressi\
onUUID->"feff8a6e-fa88-4b16-a313-835c3a19aef5"],

Cell["6. Read BHB boundary values", "Section",ExpressionUUID->"8f421dad-4cec-4a79-bef9-b3f472f9525c"],

Cell["\<\
The BHB boundary file is stored with epsilon coefficients as the first index. \
 SpectralPropagate expects an nMaster by nEpsilonCoefficient matrix, so we \
transpose it and set the numerical precision.\
\>", "Text",ExpressionUUID->"753159c2-b581-46c8-ba9d-033abd719dc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boundaryFile", "=", 
   RowBox[{"requireFile", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dataDir", ",", "\"\<BCnum.m\>\""}], "}"}], "]"}], 
    "]"}]}], ";", 
  RowBox[{"rawBoundaryValues", "=", 
   RowBox[{"Get", "[", "boundaryFile", "]"}]}], ";"}]], "Input",ExpressionUUID\
->"8dd2e314-6d51-485b-ada2-330383fa9470"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "rawBoundaryValues", "]"}], ",", 
   TagBox[
    RowBox[{"rawBoundaryValues", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}],
    Short[#, 3]& ]}], "}"}]], "Input",ExpressionUUID->"1a9c5be0-343d-4489-\
b4db-97e6ab3e9ef9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"precision", "=", "80"}], ";", 
  RowBox[{"precisionA", "=", "100"}], ";", 
  RowBox[{"boundaryValues", "=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     TemplateBox[{"rawBoundaryValues"},
      "Transpose"], ",", "precision"}], "]"}]}], ";"}]], "Input",ExpressionUUI\
D->"0a534553-acff-4d6d-8278-a49834cd7ac9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "boundaryValues", "]"}], ",", 
   RowBox[{"Precision", "[", 
    RowBox[{"boundaryValues", "\[LeftDoubleBracket]", 
     RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"4bf55e77-ddae-4e85-894a-a38578b3b982"],

Cell["7. Choose solver parameters", "Section",ExpressionUUID->"e923f152-bb23-4bdb-80fe-e9b351734240"],

Cell["\<\
BHB has a fake singularity at the left endpoint of this path, so the solve \
uses left endpoint regularization.  The default below is intentionally \
moderate for an example notebook.\
\>", "Text",ExpressionUUID->"6af02e04-6afd-43ab-8b6b-bb7811e15ff5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nodes", "=", "24"}], ";", 
  RowBox[{"kernels", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"12", ",", "$ProcessorCount"}], "]"}]}], ";", 
  RowBox[{"interval", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], ";", 
  RowBox[{"regularizedEndpoints", "=", 
   RowBox[{"{", "\"\<Left\>\"", "}"}]}], ";"}]], "Input",ExpressionUUID->\
"cb91ca19-3c32-4768-9ea7-1e1e06c897cd"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\"\<nodes\>\"", "nodes"},
    {"\"\<precision\>\"", "precision"},
    {"\"\<precisionA\>\"", "precisionA"},
    {"\"\<parallel kernels\>\"", "kernels"},
    {"\"\<regularized endpoints\>\"", "regularizedEndpoints"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Input",ExpressionUUID->"236c6eaa-aad4-4dfb-a32f-83fb8ae8ba0e"],

Cell["8. Run the BHB propagation", "Section",ExpressionUUID->"b572e6df-3802-435c-9185-a6f770faac8b"],

Cell["\<\
This is the main numerical computation.  The result is a compact positional \
CHESS result object; use the accessor functions below instead of relying on \
positions in downstream code.\
\>", "Text",ExpressionUUID->"c9b29dd2-7e38-4935-ba69-e5c2ec94e9bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bhbTiming", "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"bhbResult", "=", 
      RowBox[{"SpectralPropagate", "[", 
       RowBox[{"nAt", ",", "boundaryValues", ",", "interval", ",", 
        RowBox[{"\"\<Nodes\>\"", "\[Rule]", "nodes"}], ",", 
        RowBox[{"\"\<Precision\>\"", "\[Rule]", "precision"}], ",", 
        RowBox[{"\"\<WorkingPrecisionA\>\"", "\[Rule]", "precisionA"}], ",", 
        RowBox[{"\"\<EndpointRegularizationPrecision\>\"", "\[Rule]", 
         "precisionA"}], ",", 
        RowBox[{"\"\<RegularizedEndpoints\>\"", "\[Rule]", 
         "regularizedEndpoints"}], ",", 
        RowBox[{"\"\<ParallelEvaluation\>\"", "\[Rule]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"kernels", ">", "1"}], ",", "True", ",", "False"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<ParallelKernels\>\"", "\[Rule]", "kernels"}]}], "]"}]}], 
     ";"}], "]"}]}], ";"}]], "Input",ExpressionUUID->"1e3a79b9-0651-46e4-a938-\
724fb2b104b8"],

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"bhbResult", "===", "$Failed"}], 
   ",", "\"\<SpectralPropagate failed\>\"", 
   ",", "\"\<SpectralPropagate returned a result\>\""}], "]"}]], "Input",Expre\
ssionUUID->"93e17f67-891a-488b-9701-3ef027811c4e"],

Cell[BoxData[
 RowBox[{"bhbTiming", "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}]], "Input",ExpressionUUID->"120d6b7c-fb2c-44e3-\
9a9d-ca088a2bbbce"],

Cell["9. Inspect endpoint regularization data", "Section",ExpressionUUID->"0ff74e6c-5f2e-4b95-8eaf-ab77b80f3fd2"],

Cell["\<\
The endpoint information reports which endpoints were regularized and how \
many direct/pole letter contributions were found.\
\>", "Text",ExpressionUUID->"7f2fb6bf-989d-4e5c-99fe-3c0c53496e8f"],

Cell[BoxData[
 RowBox[{"CHESSEndpointInfo", "[", "bhbResult", "]"}]], "Input",ExpressionUUID->"6f9c2b82-0365-4241-ae9e-337edc9779fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CHESSEndpointSubBlocks", "[", "bhbResult", "]"}], "\[LeftDoubleBracket]", 
  RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]], "Input",ExpressionUUI\
D->"32747cc5-8ba7-46e9-9fdc-3f574fa378e3"],

Cell["10. Extract the final BHB integrals", "Section",ExpressionUUID->"5c0addb8-2693-41c5-a8c0-6495e2098bfb"],

Cell["\<\
CHESSFinalState returns the values at the right endpoint as an nMaster by \
nEpsilonCoefficient matrix.\
\>", "Text",ExpressionUUID->"a2f22027-1ea9-4ccd-a6fd-64c3b637d559"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bhbNodes", "=", 
   RowBox[{"CHESSNodes", "[", "bhbResult", "]"}]}], ";", 
  RowBox[{"bhbFinal", "=", 
   RowBox[{"CHESSFinalState", "[", "bhbResult", "]"}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Length", "[", "bhbNodes", "]"}], ",", 
    RowBox[{"Dimensions", "[", "bhbFinal", "]"}]}], "}"}]}]], "Input",Expressi\
onUUID->"070aab22-5b3a-4979-9840-e19c8aaa8fd8"],

Cell[BoxData[
 TagBox[
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"bhbFinal", "\[LeftDoubleBracket]", 
     RowBox[{
      RowBox[{"1", ";;", 
       RowBox[{"Min", "[", 
        RowBox[{"5", ",", 
         RowBox[{"Length", "[", "bhbFinal", "]"}]}], "]"}]}], ",", "All"}], 
     "\[RightDoubleBracket]"}], ",", "30"}], "]"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Input",ExpressionUUID->"0e1e5b26-6933-46bd-\
96c2-26e9dfb39011"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\"\<max |final|\>\"", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"N", "[", 
         RowBox[{"bhbFinal", ",", "50"}], "]"}], "]"}], "]"}], "]"}]},
    {"\"\<checksum\>\"", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "bhbFinal", "]"}], "]"}], ",", "40"}], 
      "]"}]},
    {"\"\<first node\>\"", 
     RowBox[{"First", "[", "bhbNodes", "]"}]},
    {"\"\<last node\>\"", 
     RowBox[{"Last", "[", "bhbNodes", "]"}]}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Input",ExpressionUUID->"d6f1d5a9-4e1d-4d43-82f5-efcf404ff5fe"],

Cell["11. Optional export", "Section",ExpressionUUID->"27a34fe0-5b41-4857-9e82-32a55fbf6b82"],

Cell["\<\
Run this final cell only if you want to save the computed nodes, timing, \
endpoint metadata, and final-state matrix next to the notebook.\
\>", "Text",ExpressionUUID->"24fdb2b3-1524-4f26-ba95-3ecd115346b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"outputFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"exampleDir", ",", 
      RowBox[{"\"\<BHB_result_nodes\>\"", "<>", 
       RowBox[{"ToString", "[", "nodes", "]"}], "<>", "\"\<.mx\>\""}]}], 
     "}"}], "]"}]}], ";", 
  RowBox[{"DumpSave", "[", 
   RowBox[{"outputFile", ",", 
    RowBox[{"{", 
     RowBox[{
     "bhbNodes", ",", "bhbFinal", ",", "bhbTiming", ",", 
      "regularizedEndpoints"}], "}"}]}], "]"}], ";", "outputFile"}]], "Input",\
ExpressionUUID->"5a35272a-74db-4809-8d9c-061d4a70e633"]
},
Saveable->True,
WindowTitle->"CHESS BHB family example",
FrontEndVersion->"14.3 for Linux x86 (64-bit) (July 8, 2025)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"75e57b3c-5af2-47c1-aade-2797be66d4a0"
]
(* End of Notebook Content *)

